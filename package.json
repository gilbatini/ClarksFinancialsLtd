{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vike build && node scripts/seo/finalize-build.mjs && node scripts/seo/generate-sitemap.mjs && node scripts/seo/verify-prerender.mjs",
    "preview": "vike preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "seo:claims-check": "node scripts/seo/claims-check.mjs",
    "seo:rank-sample": "node scripts/seo/rank-sample.mjs",
    "seo:schedule-check": "node scripts/seo/schedule-check.mjs",
    "seo:schema-validate": "node scripts/seo/verify-schema.mjs",
    "seo:generate-og": "node scripts/seo/generate-og-image.mjs",
    "seo:verify-all": "node scripts/seo/verify-all.mjs",
    "seo:bundle-report": "node scripts/seo/bundle-report.mjs",
    "seo:verify-images": "node scripts/seo/verify-images.mjs",
    "seo:verify-alt": "node scripts/seo/verify-alt.mjs",
    "seo:third-party-audit": "node scripts/seo/third-party-audit.mjs",
    "seo:verify-fonts": "node scripts/seo/verify-fonts.mjs",
    "seo:cwv-gate": "node scripts/seo/cwv-sample.mjs --output docs/seo/cwv-current.json && node scripts/seo/cwv-gate.mjs",
    "seo:verify-news": "node scripts/seo/verify-news.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.1",
    "tailwind-merge": "^3.5.0",
    "vike": "0.4.260",
    "vike-react": "0.6.25",
    "vite": "8.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "sharp": "0.35.3",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "8.2.1"
  }
}
